<Project>
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- A desktop publish adds an OS runtime graph to every referenced library.
         Keep it separate from the portable and Windows locked restores. -->
    <_NaturplayLockRuntime>$(RuntimeIdentifier)</_NaturplayLockRuntime>
    <_NaturplayLockRuntime Condition="'$(_NaturplayLockRuntime)' == ''">$(RuntimeIdentifiers)</_NaturplayLockRuntime>
    <NuGetLockFilePath Condition="'$(_NaturplayLockRuntime)' == 'osx-arm64' or '$(_NaturplayLockRuntime)' == 'osx-x64'">packages.$(_NaturplayLockRuntime).lock.json</NuGetLockFilePath>
    <RestoreLockedMode Condition="'$(RestoreLockedMode)' == ''">true</RestoreLockedMode>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
