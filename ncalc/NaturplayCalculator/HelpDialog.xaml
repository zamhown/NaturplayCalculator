<ContentDialog
    x:Class="NaturplayCalculator.HelpDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NaturplayCalculator"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="56"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0, 12, 0, 0">
            <ScrollViewer VerticalAlignment="Stretch">
                <TextBlock x:Name="textBlock" TextWrapping="Wrap" Text="TextBlock"/>
            </ScrollViewer>
        </Grid>
        <Grid Grid.Row="1" Margin="0, 24, 0, 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="bclose" x:Uid="button_close" Grid.Column="2" HorizontalAlignment="Stretch" Margin="2, 0, 0, 0" Style="{StaticResource AccentButtonStyle}" FontFamily="Segoe UI Symbol" Click="bclose_Click"/>
        </Grid>
    </Grid>
</ContentDialog>
