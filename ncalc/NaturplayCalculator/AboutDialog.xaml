<ContentDialog
    x:Class="NaturplayCalculator.AboutDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NaturplayCalculator"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <Image Source="Assets/logo2.png" Width="100" Height="100" Margin="0, 0, 10, 0"/>
            <StackPanel Margin="0,0,0,15" VerticalAlignment="Bottom">
                <TextBlock x:Name="titleBlock" Text="Title" TextWrapping="Wrap" FontSize="24" />
                <TextBlock x:Name="versionBlock" Text="Version" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
        <Grid Margin="0, 12, 0, 0">
            <TextBlock x:Name="textBlock" TextWrapping="Wrap" Text="TextBlock"/>
        </Grid>
        <Grid Margin="0, 24, 0, 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="breview" x:Uid="button_rate" Grid.Column="0" HorizontalAlignment="Stretch" Margin="0, 0, 2, 0" Click="breview_Click"/>
                <Button x:Name="bdonate" x:Uid="button_donate" Grid.Column="1" HorizontalAlignment="Stretch" Margin="2, 0, 0, 0" Click="bdonate_Click"/>
            </Grid>
            <Grid Grid.Row="1" Margin="0, 8, 0, 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="bupdate" x:Uid="button_update" Grid.Column="0" HorizontalAlignment="Stretch" Margin="0, 0, 2, 0" Click="bupdate_Click"/>
                <Button x:Name="bhelp" x:Uid="button_help" Grid.Column="1" HorizontalAlignment="Stretch" Margin="2, 0, 2, 0" FontFamily="Segoe UI Symbol" Click="bhelp_Click"/>
                <Button x:Name="bclose" x:Uid="button_close" Grid.Column="2" HorizontalAlignment="Stretch" Margin="2, 0, 0, 0" Style="{StaticResource AccentButtonStyle}" Click="bclose_Click"/>
            </Grid>
        </Grid>
    </StackPanel>
</ContentDialog>
