                                       HorizontalAlignment="Stretch" VerticalAlignment="Top"
                                       PointerEntered="DisplayRegion_PointerEntered" PointerExited="DisplayRegion_PointerExited">
                    </ctls:GridSplitter>
                </Grid>
            </Grid>
        </Grid>
    </Viewbox>
</Page>
