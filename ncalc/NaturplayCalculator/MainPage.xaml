                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="1*"/>
                                        <RowDefinition Height="1*"/>
                                        <RowDefinition Height="1*"/>
                                    </Grid.RowDefinitions>
                                    <Button Style="{x:Bind KeyStyle, Mode=OneWay}" x:Name="bpowerself2" Content="^" Grid.Column="0" Grid.Row="0"  FontSize="36" Click="bpowerself_Click" FontWeight="Bold" FontFamily="Consolas"/>

                                    <Button Style="{x:Bind KeyStyle, Mode=OneWay}" x:Name="bsqrt2" Content="√" Grid.Column="1" Grid.Row="0"  FontSize="36" Click="bsqrt_Click" FontWeight="Bold" FontFamily="Consolas"/>

                                    <Button Style="{x:Bind KeyStyle, Mode=OneWay}" x:Name="bnfact2" Content="!" Click="bnfact_Click" Grid.Row="1"  FontSize="36" FontWeight="Bold" FontFamily="Consolas"/>

                                    <Button Style="{x:Bind KeyStyle, Mode=OneWay}" x:Name="babs2" Content="Abs" Click="babs_Click" Grid.Column="1" Grid.Row="1"  FontSize="28" FontFamily="Consolas">
                                        <ToolTipService.ToolTip>
                                            <ToolTip x:Uid="tooltip_abs" />
                                        </ToolTipService.ToolTip>
                                    </Button>

                                    <Button Style="{x:Bind KeyStyle, Mode=OneWay}" x:Name="bmod2" Content="Mod" Click="bmod_Click" Grid.Row="2"  FontSize="28" FontFamily="Consolas"/>

                                    <Button Style="{x:Bind KeyStyle, Mode=OneWay}" x:Name="bans2" Content="Ans" Grid.Column="1" Grid.Row="2"  FontSize="28" Click="bans_Click" FontFamily="Consolas">
                                        <ToolTipService.ToolTip>
                                            <ToolTip x:Uid="tooltip_ans" />
