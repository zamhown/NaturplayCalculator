  <data name="tooltip_cov.Content" xml:space="preserve">
    <value>Cov: the covariance of random variables X and Y. Input combined with a matrix of 2 rows and N columns, such as "Cov(1,2,3,4,,5,6,7,8)", which means the covariance when X is 1, 2, 3, 4, and Y is 5, 6, 7, 8</value>
  </data>
  <data name="tooltip_dx.Content" xml:space="preserve">
