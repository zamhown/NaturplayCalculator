  </data>
  <data name="tooltip_ex.Content" xml:space="preserve">
    <value>Ex: average of several numbers. Input combined with matrix form, for example, "e (1,2,3,4)" means average number of 1, 2, 3, 4</value>
  </data>
  <data name="tooltip_ncr.Content" xml:space="preserve">
